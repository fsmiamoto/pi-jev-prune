{
  "name": "pi-jev-prune",
  "version": "0.1.0",
  "description": "Jev-driven context pruning for pi: replaces stale tool results with recoverable stubs before each LLM call",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fsmiamoto/pi-jev-prune.git"
  },
  "homepage": "https://github.com/fsmiamoto/pi-jev-prune#readme",
  "bugs": {
    "url": "https://github.com/fsmiamoto/pi-jev-prune/issues"
  },
  "keywords": [
    "pi",
    "pi-package",
    "pi-extension",
    "typesafe",
    "jev",
    "context",
    "pruning"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p .",
    "test:unit": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "test": "npm run typecheck && npm run test:unit",
    "test:live": "node --test --experimental-strip-types 'test/**/*.live.ts'",
    "smoke": "node --experimental-strip-types scripts/smoke.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-agent-core": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "^0.86.0",
    "@earendil-works/pi-ai": "0.86.0",
    "@earendil-works/pi-coding-agent": "0.86.0",
    "@earendil-works/pi-tui": "0.86.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
